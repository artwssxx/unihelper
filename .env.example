# Всё необязательно: без ключей приложение работает в демо-режиме
# (оценка и подборка считаются, но профиль и лиды не сохраняются, ИИ отвечает заглушкой).

# Supabase (Project Settings → API). Service role — только на сервере, никогда в браузере.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ИИ. По умолчанию — бесплатный Google Gemini (ключ: aistudio.google.com → Get API key).
GEMINI_API_KEY=
# Необязательно: свои цепочки моделей (через запятую, первая — основная).
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# GEMINI_MODELS_SMART=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest

# Явный выбор провайдера: gemini | anthropic | compat (иначе первый, для которого есть ключ).
# AI_PROVIDER=
# Claude API — когда понадобится платная модель:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Любой OpenAI-совместимый API (Groq, OpenRouter…):
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=

# Telegram: уведомления о новых лидах в чат команды
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Подпись попыток моков (обязательно в продакшене, 32+ случайных символа)
MOCK_SECRET=

# Админка /admin: пароль входа (обязателен в продакшене). Правки сохраняются в Supabase (миграция 0003).
ADMIN_PASSWORD=

# Вход: публичный ключ Supabase (Project Settings → API → anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Telegram: токен бота (@BotFather) и его username без @. В @BotFather: /setdomain → домен сайта.
# TELEGRAM_BOT_TOKEN уже используется и для уведомлений о лидах.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Еженедельный дайджест в Telegram (Vercel Cron шлёт Authorization: Bearer <CRON_SECRET>). Любая длинная случайная строка.
CRON_SECRET=
# Необязательно: свой секрет вебхука (по умолчанию выводится из токена бота)
# TELEGRAM_WEBHOOK_SECRET=
# Тестовое включение Pro без оплаты (выключить: off)
# TEST_PRO=off

# Google Analytics 4: ID потока данных (G-XXXXXXX). Пусто — аналитика выключена.
NEXT_PUBLIC_GA_ID=
